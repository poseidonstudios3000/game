# Deployer private key (0x-prefixed). Never commit a real key.
PRIVATE_KEY=
# Initial virtual ETH reserve in wei (0.01 ether — small so testnet coins can graduate)
VIRTUAL_ETH_START=10000000000000000
# Address that receives the 1% trade fee (defaults to deployer if empty)
FEE_RECIPIENT=
# Robinhood Chain testnet RPC (chain id 46630)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
# Robinhood Chain mainnet RPC (chain id 4663)
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
